# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
MINICPM_ADMIN_PASSWORD=

# Ollama model tag. Q4_K_M is the default; :Q8_0 and :F16 also exist.
MINICPM_MODEL=hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
# Also on the /admin/ Settings card (applies after a restart; pull a new model from the Updates card).

# Port the service listens on (compose: the port published by the load balancer).
MINICPM_PORT=9130

# Compose only: API copies behind nginx, and requests Ollama runs at once.
MINICPM_REPLICAS=1
OLLAMA_NUM_PARALLEL=2
# OLLAMA_MEM_LIMIT=6g
# OLLAMA_KEEP_ALIVE=5m

# Which Ollama to use. Default: the one already running on the host. It must listen on 0.0.0.0 and have the model:
#   ollama pull hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
# OLLAMA_URL=http://host.docker.internal:11434
# To run an Ollama inside this stack instead (it pulls the model itself):
# COMPOSE_PROFILES=bundled-ollama
# OLLAMA_URL=http://ollama:11434
# OLLAMA_NUM_PARALLEL only labels the admin page here; set the real value on the Ollama you use.

# Cap the CPU threads Ollama uses per request. Compose defaults to 4; set to the cores the container/host really
# gives you (run.bat: unset = Ollama decides). A value saved on the /admin/ page beats this one.
# MINICPM_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, project model prefix, warm-up) are set on the /admin/ Settings card and
# saved in settings.json. These variables are only a starting value for run.bat; compose does not pass them.
# A saved value wins.
# MINICPM_UPDATE_CHECK_HOURS=6
# MINICPM_MAX_INFLIGHT=
# MINICPM_PROJECT_PREFIX=minicpm-
# MINICPM_WARM=1

# run.bat only (compose sets these itself): bind address and where Ollama is.
# MINICPM_HOST=127.0.0.1
# OLLAMA_URL=http://127.0.0.1:11434
# Where project tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# MINICPM_TOKENS_FILE=tokens.json
# MINICPM_WEB_DIR=web
