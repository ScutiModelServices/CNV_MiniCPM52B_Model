# Copy to .env (git-ignored). run.bat loads it (--dotenv); Docker compose reads it; a real environment variable wins.
# Start-up values only; a value saved on the /admin/ page beats .env.

# Empty = no auth (local use only).
SERVICE_ADMIN_PASSWORD=
SERVICE_PORT=29200
# Required. Local run: http://127.0.0.1:11434. Host Ollama needs: ollama pull hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
SERVICE_OLLAMA_URL=http://host.docker.internal:11434
# Bundled Ollama instead of the host one:
# COMPOSE_PROFILES=bundled-ollama
# SERVICE_OLLAMA_URL=http://ollama:11434
# OLLAMA_MEM_LIMIT=6g
# OLLAMA_KEEP_ALIVE=5m
# Compose only
SERVICE_REPLICAS=1
# Only labels the admin page; set the real value on your Ollama
OLLAMA_NUM_PARALLEL=2
# run.bat only
# SERVICE_HOST=127.0.0.1
# Local run only: model folder (HF_HOME, OLLAMA_MODELS)
# SERVICE_MODELS_DIR=
