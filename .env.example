# Copy to .env (git-ignored). Docker compose and a local run (run.bat) read it from this folder; a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# --- Access ---
# Unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
MINICPM_ADMIN_PASSWORD=
# Port the service listens on (compose: the port published by the load balancer).
MINICPM_PORT=9130

# --- Model ---
# Ollama model tag. Q4_K_M is the default; :Q8_0 and :F16 also exist. Also on the /admin/ Settings card
# (applies after a restart; pull a new model from the Updates card).
MINICPM_OLLAMA_MODEL=hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M

# --- Ollama ---
# Default: the Ollama already running on the host. It must listen on 0.0.0.0 and have the model:
#   ollama pull hf.co/openbmb/MiniCPM5-2B-GGUF:Q4_K_M
# With run.bat use http://127.0.0.1:11434.
MINICPM_OLLAMA_URL=http://host.docker.internal:11434
# To run an Ollama inside this stack instead (it pulls the model itself):
# COMPOSE_PROFILES=bundled-ollama
# MINICPM_OLLAMA_URL=http://ollama:11434
# OLLAMA_MEM_LIMIT=6g
# OLLAMA_KEEP_ALIVE=5m

# --- Compose ---
# API copies behind nginx.
MINICPM_REPLICAS=1
# Requests Ollama runs at once. With the host Ollama this only labels the admin page and sets the in-flight cap;
# set the real value on the Ollama you use.
OLLAMA_NUM_PARALLEL=2
# CPU threads Ollama uses per request (compose default 4). Set to the physical cores. A value saved on /admin/ beats this.
# MINICPM_NUM_THREAD=4

# --- Tunables ---
# These are set on the /admin/ Settings card and saved in settings.json. The variables below only give run.bat a
# starting value (compose does not pass them); a saved value wins.
# MINICPM_UPDATE_CHECK_HOURS=6
# MINICPM_MAX_INFLIGHT=
# MINICPM_PROJECT_PREFIX=minicpm-
# MINICPM_WARM=1

# --- run.bat only (compose sets these itself) ---
# MINICPM_HOST=127.0.0.1
# MINICPM_TOKENS_FILE=tokens.json
# MINICPM_WEB_DIR=web
